<com.launcher.ui11.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".MainActivityUI11"
    tools:ignore="MissingDefaultResource">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_name_layout_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/sf_music_bg"
            android:layout_width="@dimen/music_bg_width"
            android:layout_height="@dimen/music_bg_height"
            android:src="@drawable/bg_music_widget"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/harmonyos_sans_sc_light"
            android:layout_gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/click_play_music"
            android:maxWidth="200dp"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintVertical_bias="0.1"/>

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/harmonyos_sans_sc_light"
            android:layout_gravity="right"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxWidth="200dp"
            android:singleLine="true"
            android:text="@string/music_artist"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@+id/music_widget_music_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/music_widget_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:src="@drawable/sf_music_pre"
            app:layout_constraintStart_toStartOf="@+id/sf_music_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_artist"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.15" />

        <ImageView
            android:id="@+id/music_widget_play"
            android:layout_width="@dimen/music_play_size"
            android:layout_height="@dimen/music_play_size"
            android:padding="10dp"
            android:src="@drawable/sf_music_bofang"
            app:layout_constraintStart_toStartOf="@+id/music_widget_pre"
            app:layout_constraintEnd_toEndOf="@+id/music_widget_next"
            app:layout_constraintTop_toBottomOf="@+id/music_artist"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/music_widget_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:src="@drawable/sf_music_next"
            tools:ignore="ContentDescription"
            app:layout_constraintStart_toEndOf="@+id/music_widget_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_artist"
            app:layout_constraintBottom_toBottomOf="parent" />

        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:progressDrawable="@drawable/custom_progress_drawable"
            android:thumb="@null"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone"
            tools:ignore="MissingConstraints" />


