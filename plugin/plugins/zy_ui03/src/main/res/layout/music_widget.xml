<com.launcher.zy_ui03.view.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rl_music_ablum_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.15"
            >
            <!-- 专辑图背景 -->
            <ImageView
                android:id="@+id/img_song_art_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:scaleType="fitCenter"
                android:src="@drawable/album_bg1" />
            <!-- 专辑图片 -->
            <ImageView
                android:id="@+id/img_song_art"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

        </RelativeLayout>


        <LinearLayout
            android:id="@+id/ll_name_layout_music"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintWidth_percent="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_music_ablum_bg"
            app:layout_constraintBottom_toTopOf="@+id/ll_control_layout_music"
            >
            <View android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.5"/>
            <!--歌曲名-->
            <!--<TextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp" />-->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_regular"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="@dimen/music_name_text_size" />
            <View android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.5"/>
            <!-- 歌手名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_regular"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/music_artist"
                android:textColor="@android:color/white"
                android:textSize="@dimen/music_artist_text_size"
                 />
            <View android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.5"/>
            <!-- 进度条  style="@style/volume_SeekBar"  -->
            <RelativeLayout
                android:id="@+id/ll_time_layout_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone">
                <!-- 当前时间 -->
                <TextView
                    android:id="@+id/music_widget_cur_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignStart="@+id/music_widget_seekbars2"
                    android:layout_marginStart="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 总时间 -->
                <TextView
                    android:id="@+id/music_widget_total_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignEnd="@+id/music_widget_seekbars2"
                    android:layout_marginEnd="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 进度条    style="@style/volume_SeekBar"  -->
                <SeekBar
                    android:id="@+id/music_widget_seekbars2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:thumb="@null"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>




        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.88"
            app:layout_constraintTop_toBottomOf="@+id/ll_name_layout_music">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5" />

            <com.launcher.zy_ui03.view.ImageViewTouch
                android:id="@+id/music_widget_pre"
                android:layout_width="@dimen/music_play_size"
                android:layout_height="@dimen/music_play_size"
                android:src="@drawable/music_left_white"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5" />

            <com.launcher.zy_ui03.view.ImageViewTouch
                android:id="@+id/music_widget_play"
                android:layout_width="@dimen/music_play_size"
                android:layout_height="@dimen/music_play_size"
                android:src="@drawable/music_bofang_white"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5" />

            <com.launcher.zy_ui03.view.ImageViewTouch
                android:id="@+id/music_widget_next"
                android:layout_width="@dimen/music_play_size"
                android:layout_height="@dimen/music_play_size"
                android:src="@drawable/music_right_white"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:thumb="@null"
            android:visibility="gone"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
</com.launcher.zy_ui03.view.MusicWidget>