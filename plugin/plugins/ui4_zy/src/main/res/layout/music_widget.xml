<com.launcher.ui4.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_widget" >
        <LinearLayout
            android:id="@+id/ll_name_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.26"
            app:layout_constraintTop_toTopOf="parent">
            <!--歌曲名-->
            <!--<TextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp" />-->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="@dimen/music_name_tx_size" />
            <!-- 歌手名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/music_artist"
                android:textColor="@android:color/white"
                android:textSize="@dimen/music_artist_txsize" />
            <!-- 进度条  style="@style/volume_SeekBar"  -->
            <RelativeLayout
                android:id="@+id/ll_time_layout_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone">
                <!-- 当前时间 -->
                <TextView
                    android:id="@+id/music_widget_cur_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignStart="@+id/music_widget_seekbars2"
                    android:layout_marginStart="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 总时间 -->
                <TextView
                    android:id="@+id/music_widget_total_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignEnd="@+id/music_widget_seekbars2"
                    android:layout_marginEnd="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 进度条    style="@style/volume_SeekBar"  -->
                <SeekBar
                    android:id="@+id/music_widget_seekbars2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:thumb="@null"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rl_music_ablum_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"
            android:visibility="gone"
            >

            <RelativeLayout
                android:id="@+id/rl_music_ablum_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <!-- 专辑图背景 -->
                <ImageView
                    android:id="@+id/img_song_art_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter" />
                <!-- 专辑图片 -->
                <ImageView
                    android:id="@+id/img_song_art"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ablum_default_bg"
                    tools:ignore="ContentDescription" />

            </RelativeLayout>
        </LinearLayout>
        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_name_layout_music"
            app:layout_constraintVertical_bias="0.3">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.9" />

            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="@dimen/music_widget_next_size"
                android:layout_height="@dimen/music_widget_next_size"
                android:src="@drawable/sf_music_pre"
                android:layout_gravity="center" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="@dimen/music_widget_play_size"
                android:layout_height="@dimen/music_widget_play_size"
                android:src="@drawable/sf_music_bofang"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="@dimen/music_widget_next_size"
                android:layout_height="@dimen/music_widget_next_size"
                android:src="@drawable/sf_music_next"
                android:layout_gravity="center"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.9" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:thumb="@null"
            android:progressDrawable="@drawable/custom_progress_drawable"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_control_layout_music"
            app:layout_constraintVertical_bias="0.3"/>

</com.launcher.ui4.MusicWidget>