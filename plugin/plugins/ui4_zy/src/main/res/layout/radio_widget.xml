<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sf_radio_bg"
    android:orientation="horizontal"
    android:id="@+id/radio_layout">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.5" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/radio"
            android:textSize="@dimen/radio_tv_size"
            android:textColor="@color/half_white"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:gravity="center"/>
        <com.awell.ctrlview.FrequencyTextView
            android:id="@+id/tv_radio_freq"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="@dimen/radio_freq_size"
            android:textColor="@color/white"
            android:text="107.50"
            android:gravity="center"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/iv_radio_pre"
                android:layout_width="@dimen/iv_radio_size"
                android:layout_height="@dimen/iv_radio_size"
                android:background="@drawable/sf_radio_pre1"
                />
            <ImageView
                android:id="@+id/iv_radio_next"
                android:layout_width="@dimen/iv_radio_size"
                android:layout_height="@dimen/iv_radio_size"
                android:background="@drawable/sf_radio_next1"
                android:layout_marginStart="25dp"
                />
            <RelativeLayout
                android:layout_width="@dimen/rel_size"
                android:layout_height="@dimen/rel_size"
                android:background="@drawable/grey_circle"
                android:layout_marginStart="15dp">
                <TextView
                    android:id="@+id/tv_radio_am_fm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FM"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>

        </LinearLayout>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.5" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/radio_iv_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:gravity="center">
        <ImageView
            android:layout_width="@dimen/radio_icon_size"
            android:layout_height="@dimen/radio_icon_size"
            android:src="@drawable/radio_icon" />
    </LinearLayout>
</LinearLayout>