    <!-- 收音机 -->

    <include
        android:id="@+id/radio_widget_layout"
        layout="@layout/radio_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/guideline_left3"
        app:layout_constraintStart_toEndOf="@+id/guideline_left2"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top2" />

    <!--apps info-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/sf_app_bg"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/guideline_left5"
        app:layout_constraintStart_toEndOf="@+id/guideline_left4"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top2">


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/horizontal_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/vertical_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />


        <TextView
            style="@style/sf_tv_style"
            android:layout_width="0dp"
            android:id="@+id/nav_text"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/sf_nav"
            android:src="@drawable/sf_nav"
            android:text="@string/navigation"
            app:layout_constraintBottom_toTopOf="@+id/horizontal_center"
            app:layout_constraintEnd_toStartOf="@+id/vertical_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4" />

        <TextView
            android:id="@+id/music_text"
            style="@style/sf_tv_style"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/sf_music"
            android:text="@string/music"
            app:layout_constraintBottom_toTopOf="@+id/horizontal_center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vertical_center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4" />


        <TextView
            android:id="@+id/video_text"
            style="@style/sf_tv_style"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/sf_video"
            android:text="@string/video"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vertical_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_center"
            app:layout_constraintWidth_percent="0.4" />

        <TextView
            android:id="@+id/phone_text"
            style="@style/sf_tv_style"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/sf_btphone"
            android:text="@string/phone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vertical_center"
            app:layout_constraintTop_toBottomOf="@+id/horizontal_center"
            app:layout_constraintWidth_percent="0.4" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 音乐卡片 -->
    <include
        android:id="@+id/music_widget_layout"
        layout="@layout/music_widget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline_top1"
        app:layout_constraintEnd_toStartOf="@+id/guideline_left5"
        app:layout_constraintStart_toEndOf="@+id/guideline_left2"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top" />

    <!--时间卡片-->
    <ImageView
        android:id="@+id/time_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/time_bg"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/guideline_right"
        app:layout_constraintStart_toEndOf="@+id/guideline_left6"
        app:layout_constraintTop_toTopOf="@+id/guideline_top" />

    <com.launcher.ui21.AnalogClockView
        android:id="@+id/analogClockView"
        android:layout_width="@dimen/analog_clock_size"
        android:layout_height="@dimen/analog_clock_size"
        app:layout_constraintBottom_toTopOf="@+id/time_date"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/guideline_right"
        app:layout_constraintStart_toEndOf="@+id/guideline_left6"
        app:layout_constraintTop_toTopOf="@+id/guideline_top"
        app:layout_constraintVertical_bias="0.15" />


    <TextClock
        android:id="@+id/time_hour"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:gravity="center_horizontal"
        android:textColor="#ffffff"
        android:textSize="@dimen/time_hour_text_size"
        app:layout_constraintBottom_toTopOf="@+id/time_date"
        app:layout_constraintEnd_toEndOf="@+id/time_card"
        app:layout_constraintStart_toStartOf="@+id/time_card"
        app:layout_constraintTop_toTopOf="@+id/time_card"
        app:layout_constraintBottom_toBottomOf="@+id/time_card"
        app:layout_constraintVertical_bias="0.93"
        app:layout_constraintWidth_percent="0.22" />

    <TextClock
        android:id="@+id/time_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:format12Hour="yyyy.MM.dd EEEE"
        android:format24Hour="yyyy.MM.dd EEEE"
        android:gravity="center_horizontal"
        android:textColor="#ffffff"
        android:textSize="@dimen/time_date_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/guideline_right"
        app:layout_constraintStart_toEndOf="@+id/guideline_left6"
        app:layout_constraintTop_toTopOf="@id/guideline_top"
        app:layout_constraintVertical_bias="0.87"
        app:layout_constraintWidth_percent="0.22"

        />


</androidx.constraintlayout.widget.ConstraintLayout>
