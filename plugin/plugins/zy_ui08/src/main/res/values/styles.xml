<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="host_tv_style">
        <item name="android:textSize">@dimen/host_tv_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_marginTop">@dimen/host_tv_margin_top</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
    </style>

    <style name="host_ll_style">
        <item name="android:background">@drawable/host_iv_bg</item>
        <item name="android:onClick">onClick</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="sf_tv_style_parent">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_light</item>
    </style>

    <style name="sf_tv_fmampm" parent="sf_tv_style_parent">
        <item name="android:textSize">@dimen/sf_tv_size_fmampm</item>
    </style>

    <style name="sf_tv_freq" parent="sf_tv_style_parent">
        <item name="android:textSize">@dimen/sf_tv_size_freq</item>
    </style>

    <style name="sf_tv_style" parent="sf_tv_style_parent">
        <item name="android:textSize">@dimen/sf_tv_size</item>
    </style>
</resources>