<com.launcher.ui01.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/ll_music_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_percent="0.77"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.07"
            app:layout_constraintHorizontal_bias="0.268"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music"
                android:textColor="@color/tv_color"
                android:textStyle="bold"
                android:textSize="@dimen/tv_radio_title_size" />
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:scaleType="fitXY"
                android:src="@drawable/sf_music_arrow" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_name_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/ll_music_top"
            app:layout_constraintEnd_toEndOf="@+id/ll_music_top"
            app:layout_constraintBottom_toTopOf="@+id/ll_time_layout_music"
            app:layout_constraintStart_toStartOf="@+id/ll_music_top">

            <ImageView
                android:id="@+id/img_song_art"
                android:layout_width="@dimen/music_ablum_width"
                android:layout_height="@dimen/music_ablum_height"
                android:layout_alignParentStart="true"
                android:src="@drawable/ablum_default_bg"
                android:scaleType="fitXY"
                tools:ignore="ContentDescription" />

            <!-- 文本容器：相对 ImageView 垂直居中，内部上下排列 -->
            <LinearLayout
                android:id="@+id/ll_music_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/img_song_art"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/music_ablum_margin"
                android:orientation="vertical"
                android:gravity="start|center_vertical">

                <!-- 歌曲名：上级 -->
                <com.awell.launcher2.EarqueeTextView
                    android:id="@+id/music_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textSize="@dimen/tv_music_name_size"
                    android:textColor="@color/tv_color"
                    android:textStyle="bold"
                    android:gravity="start|center_vertical"
                    android:text="@string/click_play_music" />

                <!-- 歌手名：下级 -->
                <com.awell.launcher2.EarqueeTextView
                    android:id="@+id/music_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:gravity="start|center_vertical"
                    android:text="@string/music_artist"
                    android:textColor="#506989"
                    android:textSize="@dimen/tv_music_artist_size" />

            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/ll_time_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_percent="0.862"
            app:layout_constraintStart_toStartOf="@+id/ll_music_top"
            app:layout_constraintBottom_toTopOf="@+id/ll_control_layout_music"
            app:layout_constraintTop_toBottomOf="@+id/rl_name_layout_music" >

            <SeekBar
                android:id="@+id/music_widget_seekbars"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:thumb="@drawable/music_thumb"
                android:clickable="false"
                android:focusable="false"
                android:enabled="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/custom_progress_drawable"
                />
            <!-- 当前时间 -->
            <TextView
                android:id="@+id/music_widget_cur_time_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/music_widget_seekbars"
                android:layout_alignStart="@+id/music_widget_seekbars"
                android:text="00:00"
                android:textColor="#536C88"
                android:textSize="@dimen/tv_radio_tag_size" />
            <!-- 总时间 -->
            <TextView
                android:id="@+id/music_widget_total_time_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/music_widget_seekbars"
                android:layout_alignEnd="@+id/music_widget_seekbars"
                android:text="00:00"
                android:textColor="#536C88"
                android:textSize="@dimen/tv_radio_tag_size" />
        </RelativeLayout>

        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.60"
            app:layout_constraintVertical_bias="0.94"
            >

            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="@dimen/music_iv_size"
                android:layout_height="@dimen/music_iv_size"
                android:layout_gravity="center_vertical"
                android:src="@drawable/sf_music_pre"
                tools:ignore="ContentDescription" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="@dimen/music_iv_play_size"
                android:layout_height="@dimen/music_iv_play_size"
                android:layout_gravity="center"
                android:src="@drawable/sf_music_bofang"
                tools:ignore="ContentDescription" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="@dimen/music_iv_size"
                android:layout_height="@dimen/music_iv_size"
                android:layout_gravity="center_vertical"
                android:src="@drawable/sf_music_next"
                tools:ignore="ContentDescription" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.launcher.ui01.MusicWidget>