<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_top"
        app:layout_constraintGuide_percent="0.0266"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_top_music"
        app:layout_constraintGuide_percent="0.475"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_top_nav"
        app:layout_constraintGuide_percent="0.4944"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_top_weather"
        app:layout_constraintGuide_percent="0.3403"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_top_radio"
        app:layout_constraintGuide_percent="0.3693"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_top_apps"
        app:layout_constraintGuide_percent="0.6833"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_bottom_radio"
        app:layout_constraintGuide_percent="0.6639"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_bottom_nav"
        app:layout_constraintGuide_percent="0.9625"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/guide_bottom_apps"
        app:layout_constraintGuide_percent="0.9736"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_left"
        app:layout_constraintGuide_percent="0.0266"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_left_music"
        app:layout_constraintGuide_percent="0.3609"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_left_nav"
        app:layout_constraintGuide_percent="0.3648"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_right_radio"
        app:layout_constraintGuide_percent="0.6773"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_right"
        app:layout_constraintGuide_percent="0.9734"
        />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_right_weather"
        app:layout_constraintGuide_percent="0.6469"
        />
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guide_right_apps"
        app:layout_constraintGuide_percent="0.6312"
        />

<!--music-->
    <ImageView
        android:id="@+id/iv_music_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/music_bg"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="@+id/guide_left"
        app:layout_constraintEnd_toEndOf="@+id/guide_left_music"
        app:layout_constraintTop_toTopOf="@+id/guide_top"
        app:layout_constraintBottom_toTopOf="@+id/guide_top_music"
        />


    <include layout="@layout/music_widget"
            android:id="@+id/layout_music_widget"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="@+id/iv_music_bg"
            app:layout_constraintStart_toStartOf="@+id/iv_music_bg"
            app:layout_constraintTop_toTopOf="@+id/iv_music_bg"
            app:layout_constraintBottom_toBottomOf="@+id/iv_music_bg"
        />
<!--navi-->
    <ImageView
        android:id="@+id/iv_navi_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        android:src="@drawable/navigation_bg"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="@+id/guide_left"
        app:layout_constraintEnd_toEndOf="@+id/guide_left_nav"
        app:layout_constraintTop_toTopOf="@+id/guide_top_nav"
        app:layout_constraintBottom_toTopOf="@+id/guide_bottom_nav"
        />

    <!--weather-->
    <ImageView
        android:id="@+id/iv_weather_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/weather_bg"
        android:onClick="onClick"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="@+id/guide_right_weather"
        app:layout_constraintEnd_toEndOf="@+id/guide_right"
        app:layout_constraintTop_toTopOf="@+id/guide_top"
        app:layout_constraintBottom_toTopOf="@+id/guide_top_weather"
        />
<!--radio-->
    <ImageView
        android:id="@+id/iv_radio_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/radio_bg"
        android:onClick="onClick"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="@+id/guide_right_radio"
        app:layout_constraintEnd_toEndOf="@+id/guide_right"
        app:layout_constraintTop_toTopOf="@+id/guide_top_radio"
        app:layout_constraintBottom_toTopOf="@+id/guide_bottom_radio"
        />
    <!--all apps-->
    <ImageView
        android:id="@+id/iv_apps_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/icon_bg"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="@+id/guide_right_apps"
        app:layout_constraintEnd_toEndOf="@+id/guide_right"
        app:layout_constraintTop_toTopOf="@+id/guide_top_apps"
        app:layout_constraintBottom_toTopOf="@+id/guide_bottom_apps"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/iv_apps_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_apps_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_apps_bg"
        app:layout_constraintBottom_toBottomOf="@+id/iv_apps_bg">
        
        <ImageView
            android:id="@+id/iv_apps_nav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:onClick="onClick"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintEnd_toStartOf="@+id/iv_apps_music"
            app:layout_constraintBottom_toTopOf="@+id/iv_apps_carinfo"
            android:layout_width="@dimen/app_icon_width"
            android:layout_height="@dimen/app_icon_height"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:src="@drawable/navigation_app"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/navigation"
            style="@style/tv_apps_style"
            app:layout_constraintEnd_toEndOf="@+id/iv_apps_nav"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_nav"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_nav"
            />


        <ImageView
            android:id="@+id/iv_apps_music"
            app:layout_constraintStart_toEndOf="@+id/iv_apps_nav"
            app:layout_constraintEnd_toStartOf="@+id/iv_apps_phone"
            app:layout_constraintTop_toTopOf="@+id/iv_apps_nav"
            android:onClick="onClick"
            android:layout_width="@dimen/app_icon_width"
            android:layout_height="@dimen/app_icon_height"
            android:src="@drawable/music_app"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/music"
            style="@style/tv_apps_style"
            app:layout_constraintEnd_toEndOf="@+id/iv_apps_music"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_music"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_music"
            />

        <ImageView
            android:id="@+id/iv_apps_phone"
            app:layout_constraintStart_toEndOf="@+id/iv_apps_music"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_apps_nav"
            android:onClick="onClick"
            android:layout_width="@dimen/app_icon_width"
            android:layout_height="@dimen/app_icon_height"
            android:src="@drawable/phone_app"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/phone"
            style="@style/tv_apps_style"
            app:layout_constraintEnd_toEndOf="@+id/iv_apps_phone"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_phone"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_phone"
            />


        <ImageView
            android:id="@+id/iv_apps_carinfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_nav"
            android:onClick="onClick"
            app:layout_constraintEnd_toStartOf="@+id/iv_apps_setting"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="@dimen/app_icon_width"
            android:layout_height="@dimen/app_icon_height"
            android:src="@drawable/carinfo_app"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/car_info"
            style="@style/tv_apps_style"
            app:layout_constraintEnd_toEndOf="@+id/iv_apps_carinfo"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_carinfo"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_carinfo"
            />

        <ImageView
            android:id="@+id/iv_apps_setting"
            app:layout_constraintTop_toTopOf="@+id/iv_apps_carinfo"
            android:onClick="onClick"
            app:layout_constraintBottom_toBottomOf="@+id/iv_apps_carinfo"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_music"
            android:layout_width="@dimen/app_icon_width"
            android:layout_height="@dimen/app_icon_height"
            android:src="@drawable/settings_app"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/setting"
            style="@style/tv_apps_style"
            app:layout_constraintEnd_toEndOf="@+id/iv_apps_setting"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_setting"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_setting"
            />

        <ImageView
            android:id="@+id/iv_apps_apps"
            app:layout_constraintTop_toTopOf="@+id/iv_apps_carinfo"
            android:onClick="onClick"
            app:layout_constraintBottom_toBottomOf="@+id/iv_apps_carinfo"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_phone"
            android:layout_width="@dimen/app_icon_width"
            android:layout_height="@dimen/app_icon_height"
            android:src="@drawable/all_apps"
            />
        <TextView
            android:id="@+id/tv_apps_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/apps"
            style="@style/tv_apps_style"
            app:layout_constraintEnd_toEndOf="@+id/iv_apps_apps"
            app:layout_constraintStart_toStartOf="@+id/iv_apps_apps"
            app:layout_constraintTop_toBottomOf="@+id/iv_apps_apps"
            />




    </androidx.constraintlayout.widget.ConstraintLayout>

