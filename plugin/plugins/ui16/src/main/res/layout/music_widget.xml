<com.launcher.ui16.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.launcher.ui16.TriImageCarouselView
        android:id="@+id/carousel_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:sideSize="@dimen/triiv_side_size"
        app:centerSize="@dimen/triiv_center_size"
        app:spacing="@dimen/triiv_spacing"
        app:cornerRadius="@dimen/triiv_corner_radius_size"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:id="@+id/ll_name_layout_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/carousel_view">

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:ellipsize="marquee"
            android:focusable="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/click_play_music"
            android:textColor="@android:color/white"
            android:textSize="@dimen/tv_music_name_size" />

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:ellipsize="marquee"
            android:focusable="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/music_artist"
            android:textColor="@color/grey_1915"
            android:textSize="@dimen/tv_music_artist_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_play_layout_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.5" />

        <ImageView
            android:id="@+id/music_widget_pre"
            android:layout_width="@dimen/hotset_image_size"
            android:layout_height="@dimen/hotset_image_size"
            android:src="@drawable/sf_music_pre" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_play"
            android:layout_width="@dimen/hotset_image_size"
            android:layout_height="@dimen/hotset_image_size"
            android:src="@drawable/sf_music_bofang" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_next"
            android:layout_width="@dimen/hotset_image_size"
            android:layout_height="@dimen/hotset_image_size"
            android:src="@drawable/sf_music_next" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.5" />
    </LinearLayout>
</com.launcher.ui16.MusicWidget>