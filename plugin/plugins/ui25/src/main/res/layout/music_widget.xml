<com.launcher.ui25.view.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <ImageView
            android:id="@+id/img_music_icon"
            android:layout_width="@dimen/music_icon_size"
            android:layout_height="@dimen/music_icon_size"
            android:scaleType="fitXY"
            android:src="@drawable/usb_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/img_song_art_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@drawable/ablum_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_music_icon"
        app:layout_constraintVertical_chainStyle="spread" />

<!--    <SeekBar-->
<!--        android:id="@+id/music_widget_seekbars"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="6dp"-->
<!--        android:progressDrawable="@drawable/custom_progress_drawable"-->
<!--        android:thumb="@null"-->
<!--        app:layout_constraintBottom_toBottomOf="@+id/img_song_art_bg"-->
<!--        app:layout_constraintEnd_toEndOf="@+id/img_song_art_bg"-->
<!--        app:layout_constraintStart_toStartOf="@+id/img_song_art_bg"-->
<!--        android:visibility="gone"-->
<!--        tools:ignore="MissingConstraints" />-->


    <LinearLayout
        android:id="@+id/ll_name_layout_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/img_song_art_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints">
        <!-- 歌手名 -->
        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/harmonyos_sans_sc_bold"
            android:gravity="center_horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/click_play_music"
            android:textColor="@color/white_ffffff"
            android:textSize="@dimen/text_24sp" />


        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:gravity="center_horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/music_artist"
            android:layout_marginTop="7dp"
            android:textColor="@color/music_artist_text_color"
            android:textSize="@dimen/music_artist_text_size" />
    </LinearLayout>

