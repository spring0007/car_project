<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/video_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_video"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/folder_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/video_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/video"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/video_iv"
        app:layout_constraintEnd_toEndOf="@+id/video_iv"
        app:layout_constraintTop_toTopOf="@+id/video_iv"
        app:layout_constraintBottom_toBottomOf="@+id/video_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageView
        android:id="@+id/folder_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_folder"
        app:layout_constraintStart_toEndOf="@+id/video_iv"
        app:layout_constraintEnd_toStartOf="@+id/setting_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/folder_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/folder"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/folder_iv"
        app:layout_constraintEnd_toEndOf="@+id/folder_iv"
        app:layout_constraintTop_toTopOf="@+id/folder_iv"
        app:layout_constraintBottom_toBottomOf="@+id/folder_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageView
        android:id="@+id/setting_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_setting"
        app:layout_constraintStart_toEndOf="@+id/folder_iv"
        app:layout_constraintEnd_toStartOf="@+id/all_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/setting_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/setting_iv"
        app:layout_constraintEnd_toEndOf="@+id/setting_iv"
        app:layout_constraintTop_toTopOf="@+id/setting_iv"
        app:layout_constraintBottom_toBottomOf="@+id/setting_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageView
        android:id="@+id/all_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_all"
        app:layout_constraintStart_toEndOf="@+id/setting_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/all_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/App"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/all_iv"
        app:layout_constraintEnd_toEndOf="@+id/all_iv"
        app:layout_constraintTop_toTopOf="@+id/all_iv"
        app:layout_constraintBottom_toBottomOf="@+id/all_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

</androidx.constraintlayout.widget.ConstraintLayout>