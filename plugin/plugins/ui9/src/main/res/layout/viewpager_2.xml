<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/video_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_video"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/folder_iv"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/video_tv"
            style="@style/marquee_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/video"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1"
            app:layout_constraintWidth_percent="0.9" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/folder_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_folder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/setting_iv"
        app:layout_constraintStart_toEndOf="@+id/video_iv"
        app:layout_constraintTop_toTopOf="parent">

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/folder_tv"
            style="@style/marquee_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/folder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1"
            app:layout_constraintWidth_percent="0.9" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setting_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_setting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/all_iv"
        app:layout_constraintStart_toEndOf="@+id/folder_iv"
        app:layout_constraintTop_toTopOf="parent">

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/setting_tv"
            style="@style/marquee_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/setting"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1"
            app:layout_constraintWidth_percent="0.9" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/all_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_all"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/setting_iv"
        app:layout_constraintTop_toTopOf="parent">

        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/all_tv"
            style="@style/marquee_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/App"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1"
            app:layout_constraintWidth_percent="0.9" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>