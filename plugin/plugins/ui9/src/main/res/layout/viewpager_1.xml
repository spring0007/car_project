<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navi_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_navi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_iv"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/navi_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/navigation"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_music"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bt_iv"
        app:layout_constraintStart_toEndOf="@+id/navi_iv"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/music_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/music"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1" />

        <include
            layout="@layout/music_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/music_iv"
            app:layout_constraintEnd_toEndOf="@+id/music_iv"
            app:layout_constraintStart_toStartOf="@+id/music_iv"
            app:layout_constraintTop_toTopOf="@+id/music_iv"
            app:layout_constraintVertical_bias="0.7" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bt_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_phone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/radio_iv"
        app:layout_constraintStart_toEndOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/bt_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/phone"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/radio_iv"
        android:layout_width="@dimen/viewpager_item_width"
        android:layout_height="@dimen/viewpager_item_height"
        android:background="@drawable/sf_radio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_iv"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/radio_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/radio"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>