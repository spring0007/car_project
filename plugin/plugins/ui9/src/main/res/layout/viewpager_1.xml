<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/navi_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_navi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/navi_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navigation"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/navi_iv"
        app:layout_constraintEnd_toEndOf="@+id/navi_iv"
        app:layout_constraintTop_toTopOf="@+id/navi_iv"
        app:layout_constraintBottom_toBottomOf="@+id/navi_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageView
        android:id="@+id/music_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_music"
        app:layout_constraintStart_toEndOf="@+id/navi_iv"
        app:layout_constraintEnd_toStartOf="@+id/bt_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/music_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/music"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/music_iv"
        app:layout_constraintEnd_toEndOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="@+id/music_iv"
        app:layout_constraintBottom_toBottomOf="@+id/music_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

    <include layout="@layout/music_widget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/music_iv"
        app:layout_constraintEnd_toEndOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="@+id/music_iv"
        app:layout_constraintBottom_toBottomOf="@+id/music_iv"
        app:layout_constraintVertical_bias="0.7" />

   <!-- <ImageView
        android:id="@+id/music_pre_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_music_pre"
        app:layout_constraintStart_toStartOf="@+id/music_iv"
        app:layout_constraintEnd_toEndOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="@+id/music_iv"
        app:layout_constraintBottom_toBottomOf="@+id/music_iv"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintVertical_bias="0.7"/>

    <ImageView
        android:id="@+id/music_next_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_music_next"
        app:layout_constraintStart_toStartOf="@+id/music_iv"
        app:layout_constraintEnd_toEndOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="@+id/music_iv"
        app:layout_constraintBottom_toBottomOf="@+id/music_iv"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintVertical_bias="0.7"/>

    <ImageView
        android:id="@+id/music_play_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_music_bofang"
        app:layout_constraintStart_toStartOf="@+id/music_iv"
        app:layout_constraintEnd_toEndOf="@+id/music_iv"
        app:layout_constraintTop_toTopOf="@+id/music_iv"
        app:layout_constraintBottom_toBottomOf="@+id/music_iv"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.7"/>-->

    <ImageView
        android:id="@+id/bt_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_phone"
        app:layout_constraintStart_toEndOf="@+id/music_iv"
        app:layout_constraintEnd_toStartOf="@+id/radio_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/bt_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phone"
        android:textSize="33sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/bt_iv"
        app:layout_constraintEnd_toEndOf="@+id/bt_iv"
        app:layout_constraintTop_toTopOf="@+id/bt_iv"
        app:layout_constraintBottom_toBottomOf="@+id/bt_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

    <ImageView
        android:id="@+id/radio_iv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_radio"
        app:layout_constraintStart_toEndOf="@+id/bt_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/radio_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/radio"
        android:textSize="33sp"
        android:textColor="@color/yellow_fdb4"
        app:layout_constraintStart_toStartOf="@+id/radio_iv"
        app:layout_constraintEnd_toEndOf="@+id/radio_iv"
        app:layout_constraintTop_toTopOf="@+id/radio_iv"
        app:layout_constraintBottom_toBottomOf="@+id/radio_iv"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintHorizontal_weight="1" />

</androidx.constraintlayout.widget.ConstraintLayout>