<com.launcher.ui26.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <ImageView
            android:id="@+id/img_song_art"
            android:layout_width="@dimen/img_song_art_size"
            android:layout_height="@dimen/img_song_art_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintEnd_toStartOf="@+id/ll_name_layout_music"
            android:scaleType="fitXY"
            android:src="@drawable/ic_album"

            tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/ll_name_layout_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintStart_toEndOf="@+id/img_song_art"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2">
        <!--歌曲名-->
        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center_horizontal|bottom"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/music"
            android:textColor="@android:color/white"
            android:textSize="@dimen/music_name_text_size" />
        <!-- 歌手名 -->
        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center_horizontal|bottom"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/artist_text_size" />
        <!-- 进度条  style="@style/volume_SeekBar"  -->
        <RelativeLayout
            android:id="@+id/ll_time_layout_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone">
            <!-- 当前时间 -->
            <TextView
                android:id="@+id/music_widget_cur_time_textview"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_below="@+id/music_widget_seekbars"
                android:layout_alignStart="@+id/music_widget_seekbars"
                android:layout_marginStart="15dp"
                android:text="00:00"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
            <!-- 总时间 -->
            <TextView
                android:id="@+id/music_widget_total_time_textview"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_below="@+id/music_widget_seekbars"
                android:layout_alignEnd="@+id/music_widget_seekbars"
                android:layout_marginEnd="15dp"
                android:text="00:00"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
            <!-- 进度条    style="@style/volume_SeekBar"  -->
            <SeekBar
                android:id="@+id/music_widget_seekbars"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="20dp"
                android:thumb="@null"
                android:visibility="gone" />
        </RelativeLayout>
    </LinearLayout>

