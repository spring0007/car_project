    <!-- 音乐控制 -->
    <LinearLayout
        android:id="@+id/ll_control_layout_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintVertical_bias="0.8"
        app:layout_constraintTop_toBottomOf="@+id/ll_name_layout_music"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_song_art">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_pre"
            android:layout_width="@dimen/music_play_width"
            android:layout_height="@dimen/music_play_height"
            android:src="@drawable/sf_music_pre"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_play"
            android:layout_width="@dimen/music_play_size"
            android:layout_height="@dimen/music_play_size"
            android:src="@drawable/sf_music_bofang"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_next"
            android:layout_width="@dimen/music_play_width"
            android:layout_height="@dimen/music_play_height"
            android:src="@drawable/sf_music_next"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

