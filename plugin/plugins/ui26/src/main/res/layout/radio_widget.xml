<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_radio_pre"
        android:layout_width="@dimen/iv_radio_size"
        android:layout_height="@dimen/iv_radio_size"
        android:layout_gravity="center_vertical"
        android:onClick="onClick"
        android:scaleType="fitXY"
        android:src="@drawable/sf_music_pre" />

    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

    <LinearLayout
        android:layout_width="@dimen/radio_bg_size"
        android:layout_height="@dimen/radio_bg_size"
        android:background="@drawable/ic_radio_round_bg"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <TextView
            android:id="@+id/tv_radio_am_fm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="FM"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_amfm_size" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <com.awell.ctrlview.FrequencyTextView
            android:id="@+id/tv_radio_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="87.5"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_radio_freq_size" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <TextView
            android:id="@+id/tv_radio_freq_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:gravity="center"
            android:text="MHz"
            android:textColor="@color/white"
            android:textSize="@dimen/tv_radio_freq_unit_size" />

        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.5" />


    </LinearLayout>

    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

    <ImageView
        android:id="@+id/iv_radio_next"
        android:layout_width="@dimen/iv_radio_size"
        android:layout_height="@dimen/iv_radio_size"
        android:layout_gravity="center_vertical"
        android:onClick="onClick"
        android:scaleType="fitXY"
        android:src="@drawable/sf_music_next" />
</LinearLayout>