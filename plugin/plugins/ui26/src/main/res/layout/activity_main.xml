<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--    <ImageView-->
    <!--        android:layout_width="1280dp"-->
    <!--        android:layout_height="720dp"-->
    <!--        android:scaleType="fitXY"-->
    <!--        android:src="@drawable/ui_icon"-->
    <!--        android:alpha="0.5"-->
    <!--        />-->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.0875" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1015" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_ver_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.586" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_ver_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.60" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.986" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1097" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7222" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7444" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3222" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.34" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6527" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.67" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.9833" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.9777" />

    <ImageView
        android:id="@+id/iv_apps_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_navi_bg"
        app:layout_constraintTop_toTopOf="@+id/guideline_top"
        app:layout_constraintEnd_toStartOf="@+id/guideline_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@+id/iv_apps_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_apps_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_apps_bg"
        app:layout_constraintBottom_toBottomOf="@+id/iv_apps_bg"
        android:gravity="center_horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            />


        <ImageView
            android:id="@+id/hotset_navi"
            android:layout_width="@dimen/host_cell_size"
            android:layout_height="@dimen/host_cell_size"
            android:onClick="onClick"
            android:src="@drawable/ic_navigation"
           />
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            />

        <ImageView
            android:id="@+id/hotset_bt_phone"
            android:layout_width="@dimen/host_cell_size"
            android:layout_height="@dimen/host_cell_size"
            android:onClick="onClick"
            android:src="@drawable/ic_bt_phone"
            />
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            />
        <ImageView
            android:id="@+id/hotset_settings"
            android:layout_width="@dimen/host_cell_size"
            android:layout_height="@dimen/host_cell_size"
            android:onClick="onClick"
            android:src="@drawable/ic_settings" />
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            />
        <ImageView
            android:id="@+id/hotset_allapp"
            android:layout_width="@dimen/host_cell_size"
            android:layout_height="@dimen/host_cell_size"
            android:onClick="onClick"
            android:src="@drawable/hotset_all_app" />
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="2"
            />



        <ImageView
            android:id="@+id/hotset_change"
            android:layout_width="@dimen/host_cell_size"
            android:layout_height="@dimen/host_cell_size"
            android:onClick="onClick"
            android:src="@drawable/ic_change" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            />
    </LinearLayout>
    
    <ImageView
        android:id="@+id/car_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_car_bg"
        app:layout_constraintTop_toTopOf="@+id/guideline_top"
        app:layout_constraintStart_toEndOf="@+id/guideline_left1"
        app:layout_constraintEnd_toStartOf="@+id/guideline_ver_line1"
        app:layout_constraintBottom_toTopOf="@+id/guideline_top1"
        />

    <LinearLayout
        android:id="@+id/car_speed_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@+id/car_card"
        app:layout_constraintStart_toStartOf="@+id/car_card"
        app:layout_constraintTop_toTopOf="@+id/car_card"
        app:layout_constraintBottom_toBottomOf="@+id/car_card"
        app:layout_constraintVertical_bias="0.25"
        >

        <TextView
            android:id="@+id/car_speed_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="70sp" />

        <TextView
            android:id="@+id/car_speed_unit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:text="Km/h"
            android:textColor="#E1E1E1"
            android:textSize="30sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/app_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_collect_bg"
        app:layout_constraintTop_toTopOf="@+id/guideline_top2"
        app:layout_constraintStart_toEndOf="@+id/guideline_left1"
        app:layout_constraintEnd_toStartOf="@+id/guideline_ver_line1"
        app:layout_constraintBottom_toTopOf="@+id/guideline_bottom"
        />

    <LinearLayout
        android:id="@+id/rv_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/app_card"
        app:layout_constraintEnd_toEndOf="@+id/app_card"
        app:layout_constraintStart_toStartOf="@+id/app_card"
        app:layout_constraintTop_toTopOf="@+id/app_card" >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>
    </LinearLayout>
    <!--time-->
    <ImageView
        android:id="@+id/time_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_data_bg"
        app:layout_constraintTop_toTopOf="@+id/guideline_top"
        app:layout_constraintStart_toEndOf="@+id/guideline_ver_line2"
        app:layout_constraintEnd_toStartOf="@+id/guideline_right"
        app:layout_constraintBottom_toTopOf="@+id/guideline_top3"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_time"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        app:layout_constraintBottom_toBottomOf="@+id/time_card"
        app:layout_constraintStart_toStartOf="@+id/time_card"
        app:layout_constraintTop_toTopOf="@id/time_card"
        app:layout_constraintEnd_toEndOf="@+id/time_card">

        <TextClock
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="@dimen/time_font_size1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintEnd_toStartOf="@+id/time_date"
            />

        <TextClock
            android:id="@+id/time_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:format12Hour="yyyy/MM/dd"
            android:format24Hour="yyyy/MM/dd"
            android:text="2025/02/23"
            android:textColor="@android:color/white"
            android:textSize="@dimen/date_font_size1"
            app:layout_constraintStart_toEndOf="@+id/time"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/time_week"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <TextClock
            android:id="@+id/time_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="start"
            android:textColor="@android:color/white"
            android:textSize="@dimen/date_font_size1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/time_date"
            app:layout_constraintEnd_toEndOf="@+id/time_date"
            app:layout_constraintTop_toBottomOf="@+id/time_date"

            />
    </androidx.constraintlayout.widget.ConstraintLayout>

<!--music-->
    <ImageView
        android:id="@+id/iv_music_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        android:scaleType="fitXY"
        android:src="@drawable/ic_music_bg"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_top5"
        app:layout_constraintStart_toEndOf="@+id/guideline_ver_line2"
        app:layout_constraintEnd_toStartOf="@+id/guideline_right"
        app:layout_constraintTop_toTopOf="@+id/guideline_top4" />

    <include
        android:id="@+id/layout_music_widget"
        layout="@layout/music_widget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_music_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_music_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_music_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_music_bg" />

    <ImageView
        android:id="@+id/iv_radio_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onClick"
        android:scaleType="fitXY"
        android:src="@drawable/ic_radio_bg"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_bottom1"
        app:layout_constraintStart_toEndOf="@+id/guideline_ver_line2"
        app:layout_constraintEnd_toStartOf="@+id/guideline_right"
        app:layout_constraintTop_toTopOf="@+id/guideline_top6" />

   <include
        android:id="@+id/layout_radio_widget"
        layout="@layout/radio_widget"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
       app:layout_constraintWidth_percent="0.3"
        app:layout_constraintBottom_toBottomOf="@id/iv_radio_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_radio_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_radio_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_radio_bg" />


</androidx.constraintlayout.widget.ConstraintLayout>