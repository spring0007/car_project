<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_radio_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/iv_radio_icon"
        android:layout_width="@dimen/iv_radio_icon_width"
        android:layout_height="@dimen/iv_radio_icon_height"
        android:src="@drawable/radio_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_radio_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/ll_radio_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.58">

        <TextView
            android:id="@+id/tv_radio_am_fm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="FM"
            android:textColor="@color/white"
            android:textSize="@dimen/text_26sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_radio_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:text="87.5"
            android:textColor="@color/white"
            android:textSize="@dimen/text_42sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_radio_freq_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="MHz"
            android:textColor="@color/white"
            android:textSize="@dimen/text_26sp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_radio_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ll_radio_info"
        app:layout_constraintStart_toStartOf="@+id/ll_radio_info"
        app:layout_constraintTop_toBottomOf="@+id/ll_radio_info">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <ImageView
            android:id="@+id/iv_radio_pre"
            android:layout_width="@dimen/iv_radio_image_size"
            android:layout_height="@dimen/iv_radio_image_size"
            android:scaleType="fitXY"
            android:src="@drawable/sf_radio_pre" />

        <!--        <View-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_height="0dp"-->
        <!--            android:layout_weight="0.5" />-->

        <!--        <ImageView-->
        <!--            android:id="@+id/iv_radio_play_pause"-->
        <!--            android:layout_width="@dimen/iv_radio_image_size"-->
        <!--            android:layout_height="@dimen/iv_radio_image_size"-->
        <!--            android:padding="10dp"-->
        <!--            android:background="@drawable/sf_radio_play"-->
        <!--            tools:ignore="ContentDescription" />-->

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <ImageView
            android:id="@+id/iv_radio_next"
            android:layout_width="@dimen/iv_radio_image_size"
            android:layout_height="@dimen/iv_radio_image_size"
            android:scaleType="fitXY"
            android:src="@drawable/sf_radio_next" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.5" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>