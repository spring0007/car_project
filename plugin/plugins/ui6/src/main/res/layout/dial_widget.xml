<?xml version="1.0" encoding="utf-8"?>
<com.launcher.ui6.view.DialWidget
 xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dial_widget_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/dial_time"
        android:text="11:25"
        android:textSize="32sp"
        android:textColor="@color/white"
        android:layout_gravity="center"
        />
    <com.launcher.ui6.view.AnalogClockView
        android:id="@+id/analogClockView"
        android:layout_marginTop="8dp"
        android:layout_width="@dimen/analog_clock_view_size"
        android:layout_height="@dimen/analog_clock_view_size"
        android:layout_gravity="center"
        tools:ignore="MissingConstraints" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dial_date_top"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/dial_date"
            android:text="11-03"
            android:textSize="30sp"
            android:textColor="@color/white"
            android:layout_marginEnd="70dp"
            android:layout_gravity="center_vertical|left"
            android:visibility="gone"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/dial_week"
            android:text="@string/monday"
            android:textSize="30sp"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical|right"
            android:visibility="gone"
            />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="MM/dd"
            android:format24Hour="MM/dd"
            android:text="5月18日"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:layout_marginEnd="70dp"
            android:layout_gravity="center_vertical|left"/>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:text="星期五"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:layout_gravity="center_vertical|left"/>

    </LinearLayout>
</com.launcher.ui6.view.DialWidget>