<com.launcher.zy_ui01.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context="com.launcher.zy_ui01.MainActivityUI1"
    tools:ignore="MissingDefaultResource">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_name_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/rl_music_ablum_container"
            app:layout_constraintTop_toTopOf="@+id/rl_music_ablum_container"
            app:layout_constraintVertical_bias="0.0"
            android:visibility="gone">
            <!--歌曲名-->
            <!--<TextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp" />-->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:visibility="gone"/>
            <!-- 歌手名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="start|center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:text="@string/music_artist"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:visibility="gone" />
            <!-- 进度条  style="@style/volume_SeekBar"  -->
            <RelativeLayout
                android:id="@+id/ll_time_layout_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone">
                <!-- 当前时间 -->
                <TextView
                    android:id="@+id/music_widget_cur_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignStart="@+id/music_widget_seekbars2"
                    android:layout_marginStart="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 总时间 -->
                <TextView
                    android:id="@+id/music_widget_total_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignEnd="@+id/music_widget_seekbars2"
                    android:layout_marginEnd="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 进度条    style="@style/volume_SeekBar"  -->
                <SeekBar
                    android:id="@+id/music_widget_seekbars2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:thumb="@null"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rl_music_ablum_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/rl_music_ablum_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <!-- 专辑图背景 -->
                <ImageView
                    android:id="@+id/img_song_art_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ablum_bg" />
                <!-- 专辑图片 -->
                <ImageView
                    android:id="@+id/img_song_art"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ablum_default_bg"
                    tools:ignore="ContentDescription" />

            </RelativeLayout>
        </LinearLayout>
        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.1" />

            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="@dimen/music_iv_size"
                android:layout_height="@dimen/music_iv_size"
                android:src="@drawable/selector_pre"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.2" />

            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="@dimen/music_iv_size"
                android:layout_height="@dimen/music_iv_size"
                android:src="@drawable/selector_play"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.2" />

            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="@dimen/music_iv_size"
                android:layout_height="@dimen/music_iv_size"
                android:src="@drawable/selector_next"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.1" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:thumb="@null"
            android:progressDrawable="@drawable/custom_progress_drawable"
            android:visibility="gone"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_music_ablum_container" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.launcher.zy_ui01.MusicWidget>