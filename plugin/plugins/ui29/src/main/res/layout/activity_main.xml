<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1694" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.9194" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1093" />

    <!-- 左侧图标栏 -->
    <ImageView
        android:id="@+id/left_icon_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/sf_left_side"
        app:layout_constraintHeight_percent="0.9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_left"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 主页图标 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/left_icon_bar"
        app:layout_constraintEnd_toEndOf="@+id/left_icon_bar"
        app:layout_constraintStart_toStartOf="@+id/left_icon_bar"
        app:layout_constraintTop_toTopOf="@+id/left_icon_bar">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/navigation_icon"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_height"
            android:layout_gravity="center"
            android:onClick="onClick"
            android:src="@drawable/hotset_navigation" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/all_icon"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_height"
            android:layout_gravity="center"
            android:onClick="onClick"
            android:src="@drawable/hotset_all_app" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/bt_icon"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_height"
            android:layout_gravity="center"
            android:onClick="onClick"
            android:src="@drawable/hotset_phone"
            />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/radio_icon"
            android:layout_width="@dimen/icon_width"
            android:layout_height="@dimen/icon_height"
            android:layout_gravity="center"
            android:onClick="onClick"
            android:src="@drawable/hotset_radio"/>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
    <!-- 导航卡片 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navigation_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/sf_nav_bg"
        app:layout_constraintBottom_toBottomOf="@+id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@+id/time_card"
        app:layout_constraintStart_toStartOf="@+id/guideline_left"
        app:layout_constraintTop_toTopOf="@+id/guideline_top"
        app:layout_constraintWidth_percent="0.2656">

        <TextView
            android:id="@+id/car_speed_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.25"
            android:text="0"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:textColor="@android:color/white"
            android:textSize="@dimen/tv_speed_size" />
        <TextView
            android:id="@+id/car_speed_unit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           app:layout_constraintTop_toBottomOf="@+id/car_speed_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="KM/h"
            android:textColor="@android:color/white"
            android:textSize="@dimen/tv_unit_size"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 时间卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/time_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/sf_time_bg"
            app:layout_constraintBottom_toBottomOf="@+id/guideline_bottom"
            app:layout_constraintEnd_toStartOf="@+id/music_card"
            app:layout_constraintStart_toEndOf="@+id/navigation_card"
            app:layout_constraintTop_toTopOf="@+id/guideline_top"
            app:layout_constraintWidth_percent="0.2656">


            <ImageView
                android:id="@+id/time_icon"
                android:layout_width="@dimen/time_icon_width"
                android:layout_height="@dimen/time_icon_width"
                android:src="@drawable/ic_date_view_icon"
                android:layout_marginEnd="5dp"
                app:layout_constraintEnd_toStartOf="@+id/time_title"
                app:layout_constraintBottom_toBottomOf="@+id/time_title"
                app:layout_constraintTop_toTopOf="@+id/time_title"
                />

            <TextView
                android:id="@+id/time_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|center_horizontal"
                android:text="@string/time"
                android:textColor="@color/text_color"
                android:textSize="@dimen/tv_title_size"
                app:layout_constraintStart_toEndOf="@+id/time_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.05"
                app:layout_constraintHorizontal_bias="0.2"
                />

            <TextClock
                android:id="@+id/time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/harmonyos_sans_sc_regular"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.28"
                android:textColor="@color/text_color"
                android:textSize="@dimen/time_value_size" />
            
            <ImageView
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:src="@drawable/ic_date_view_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.98"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/time_value"
                app:layout_constraintBottom_toTopOf="@+id/date_value"
                />
                <TextClock
                    android:id="@+id/date_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.62"
                    android:fontFamily="@font/harmonyos_sans_sc_regular"
                    android:format12Hour="yyyy-MM-dd"
                    android:format24Hour="yyyy-MM-dd"
                    android:textColor="@color/text_color"
                    android:textSize="@dimen/date_text_size" />

                <TextClock
                    android:id="@+id/weekday_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/weekday_margin_top"
                    app:layout_constraintTop_toBottomOf="@+id/date_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/harmonyos_sans_sc_regular"
                    android:format12Hour="EEEE"
                    android:format24Hour="EEEE"
                    android:textColor="@color/text_color"
                    android:textSize="@dimen/date_text_size" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 音乐卡片 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/music_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/sf_music_bg"
            app:layout_constraintBottom_toBottomOf="@+id/guideline_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/time_card"
            app:layout_constraintTop_toTopOf="@+id/guideline_top"
            app:layout_constraintWidth_percent="0.2656">



            <ImageView
                android:id="@+id/music_icon"
                android:layout_width="@dimen/time_icon_width"
                android:layout_height="@dimen/time_icon_width"
                android:src="@drawable/ic_music_view_icon"
                android:layout_marginEnd="5dp"
                app:layout_constraintEnd_toStartOf="@+id/music_title"
                app:layout_constraintBottom_toBottomOf="@+id/music_title"
                app:layout_constraintTop_toTopOf="@+id/music_title"
                />

            <TextView
                android:id="@+id/music_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|center_horizontal"
                android:text="@string/music"
                android:textColor="@color/text_color"
                android:textSize="@dimen/tv_title_size"
                app:layout_constraintStart_toEndOf="@+id/music_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.05"
                app:layout_constraintHorizontal_bias="0.2"
                />


            <include
                layout="@layout/music_widget"
                android:id="@+id/layout_music_widget"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@+id/music_title"
                app:layout_constraintBottom_toBottomOf="@+id/music_card"
                app:layout_constraintEnd_toEndOf="@+id/music_card"
                app:layout_constraintHeight_percent="0.82"
                app:layout_constraintStart_toStartOf="@+id/music_card"
                app:layout_constraintVertical_bias="0.3"
                app:layout_constraintWidth_percent="0.85" />


        </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
