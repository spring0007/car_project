<com.launcher.ui20.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

        <ImageView
            android:id="@+id/img_song_art_bg"
            android:layout_width="@dimen/music_widget_logo_size"
            android:layout_height="@dimen/music_widget_logo_size"
            android:src="@drawable/ablum_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="parent" />


        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/click_play_music"
            android:textColor="@android:color/white"
            android:textSize="@dimen/tv_music_name_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_song_art_bg"
            app:layout_constraintWidth_percent="0.9"
            tools:ignore="MissingConstraints" />

        <!--        <com.awell.launcher2.EarqueeTextView-->
        <!--            android:id="@+id/music_artist"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_gravity="center_horizontal"-->
        <!--            android:ellipsize="marquee"-->
        <!--            android:focusable="true"-->
        <!--            android:marqueeRepeatLimit="marquee_forever"-->
        <!--            android:singleLine="true"-->
        <!--            android:text="@string/music_artist"-->
        <!--            android:textColor="@color/grey_1915"-->
        <!--            android:visibility="gone"-->
        <!--            android:textSize="@dimen/tv_music_name_size" />-->


        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.87"
            app:layout_constraintTop_toBottomOf="@+id/music_widget_music_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/ll_play_layout_music"
            android:progressDrawable="@drawable/seekbar_color"
            android:thumb="@null"
             />

        <LinearLayout
            android:id="@+id/ll_play_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_widget_seekbars">


            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="@dimen/music_pre_size"
                android:layout_height="@dimen/music_pre_size"
                android:src="@drawable/sf_music_pre" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="@dimen/music_play_width"
                android:layout_height="@dimen/music_play_height"
                android:src="@drawable/sf_music_bofang" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="@dimen/music_pre_size"
                android:layout_height="@dimen/music_pre_size"
                android:src="@drawable/sf_music_next" />

        </LinearLayout>
</com.launcher.ui20.MusicWidget>