<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UIActivity">

    <include
        android:id="@+id/include_radio"
        layout="@layout/widget_layout_radio_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/iv_main_xiaodeng"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <ImageView
        android:id="@+id/iv_main_xiaodeng"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:src="@drawable/off"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />


    <include
        layout="@layout/widget_layout_music_plugin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25" />

    <include
        android:id="@+id/include_speed_layout"
        layout="@layout/speed_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.68"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.78" />

    <FrameLayout
        android:id="@+id/host_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="143dp"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/hotset_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/hotseat_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom">

            <View
                android:id="@+id/start_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/hotset_video"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_video" />

            <ImageView
                android:id="@+id/hotset_navi"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_navi" />

            <ImageView
                android:id="@+id/hotset_allapp"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_all_app" />

            <ImageView
                android:id="@+id/hotset_setting"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_setting" />

            <ImageView
                android:id="@+id/hotset_bluetooth"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_bt" />

            <ImageView
                android:id="@+id/hotset_moshi"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_moshi"
                android:visibility="gone" />

            <View
                android:id="@+id/end_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />


            <ImageView
                android:id="@+id/hotset_dianhua"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/hotset_dianhua"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>