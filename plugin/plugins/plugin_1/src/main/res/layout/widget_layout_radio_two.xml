<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_radio_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="vertical">
        <!--<com.awell.ctrlview.WaveformView
            android:id="@+id/waveformView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="bottom|center_horizontal"
            app:rect_space="3dp"
            app:rect_width="22dp"/>-->
        <com.awell.ctrlview.VisualizerView
            android:id="@+id/waveformView"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:gravity="bottom|center_horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/radio_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_radio_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:src="@drawable/sf_radio_pre" />

        <TextView
            android:id="@+id/tv_radio_am_fm"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/harmonyos_sans_sc_black"
            android:gravity="center"
            android:text="FM"
            android:textColor="#000000"
            android:textDirection="locale"
            android:textSize="32sp" />

        <com.awell.ctrlview.FrequencyTextView
            android:id="@+id/tv_radio_freq"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/harmonyos_sans_sc_bold"
            android:gravity="center"
            android:text="87.5"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/tv_radio_freq_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/harmonyos_sans_sc_black"
            android:gravity="center"
            android:text="MHz"
            android:textColor="@android:color/black"
            android:textDirection="locale"
            android:textSize="30sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_radio_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:src="@drawable/sf_radio_next" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/radio_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radio_bar_icon_bg" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/radio_control_ll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/date_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

        <Button
            android:id="@+id/iv_radio_setFM"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:padding="10dp"
            android:text="FM"
            android:textColor="@android:color/black"
            android:textSize="30sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/iv_radio_setSearch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:padding="10dp"
            android:text="@string/radio_save"
            android:textColor="@android:color/black"
            android:textSize="30sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/iv_radio_setYC"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:padding="10dp"
            android:text="@string/radio_dx"
            android:textColor="@android:color/black"
            android:textSize="30sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />
    </LinearLayout>
</LinearLayout>