<com.example.plugin2.MusicWidgetPlugin2 xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".UI2Activity"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/music_widget_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="2"
            android:visibility="gone">

            <ImageView
                android:id="@+id/music_widget_artists_image_view"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:src="@drawable/music_ablum_bg" />

            <ImageView
                android:id="@+id/icon_music_img"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignLeft="@+id/music_widget_artists_image_view"
                android:layout_alignTop="@+id/music_widget_artists_image_view"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/icon_music_img"
                android:visibility="visible" />

            <com.awell.ctrlview.CircleImageView
                android:id="@+id/music_artists_image_view"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ablum_default_bg" />

            <ImageView
                android:id="@+id/music_artists_image_view_bar"
                android:layout_width="50dp"
                android:layout_height="160dp"
                android:layout_alignTop="@+id/music_artists_image_view"
                android:layout_alignRight="@+id/music_artists_image_view"
                android:layout_marginTop="10dp"
                android:layout_marginRight="0dp"
                android:src="@drawable/music_bar_img"
                android:visibility="visible" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/ll_name_layout_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--歌曲名-->
            <!--<TextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp" />-->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp" />
            <!-- 歌手名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="start|center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:text="@string/music_artist"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:visibility="gone" />
            <!-- 进度条  style="@style/volume_SeekBar"  -->
            <RelativeLayout
                android:id="@+id/ll_time_layout_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone">
                <!-- 当前时间 -->
                <TextView
                    android:id="@+id/music_widget_cur_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignLeft="@+id/music_widget_seekbars2"
                    android:layout_marginLeft="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone" />
                <!-- 总时间 -->
                <TextView
                    android:id="@+id/music_widget_total_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignRight="@+id/music_widget_seekbars2"
                    android:layout_marginRight="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone" />
                <!-- 进度条    style="@style/volume_SeekBar"  -->
                <SeekBar
                    android:id="@+id/music_widget_seekbars2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:thumb="@null"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rl_music_ablum_container"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:gravity="center">

            <RelativeLayout
                android:id="@+id/rl_music_ablum_bg"
                android:layout_width="260dp"
                android:layout_height="260dp">
                <!-- 专辑图背景 -->
                <ImageView
                    android:id="@+id/img_song_art_bg"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ablum_bg" />
                <!-- 专辑图片 -->
                <ImageView
                    android:id="@+id/img_song_art"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ablum_default_bg" />

                <ProgressBar
                    android:id="@+id/music_widget_seekbars"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="238dp"
                    android:layout_height="238dp"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress_bar" />
            </RelativeLayout>
        </LinearLayout>
        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="350dp"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />

            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:src="@drawable/sf_music_pre" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:src="@drawable/sf_music_bofang" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:src="@drawable/sf_music_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.8" />
        </LinearLayout>
    </LinearLayout>
</com.example.plugin2.MusicWidgetPlugin2>