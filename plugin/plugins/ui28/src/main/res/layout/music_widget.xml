<com.launcher.ui28.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_music_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ll_name_layout_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <!--歌曲名-->
        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/click_play_music"
            android:textColor="@android:color/black"
            android:textSize="@dimen/music_name_tx_size" />
        <!-- 歌手名 -->
        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="@string/music_artist"
            android:layout_marginTop="10dp"
            android:textColor="@android:color/black"
            android:textSize="@dimen/music_artist_txsize" />

    </LinearLayout>
    <SeekBar
        android:id="@+id/music_widget_seekbars"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintWidth_percent="0.7"
        android:progressDrawable="@drawable/custom_progress_drawable"
        android:thumb="@null"
        app:layout_constraintBottom_toTopOf="@+id/ll_control_layout_music"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_name_layout_music"
        />
    <!-- 音乐控制 -->
    <LinearLayout
        android:id="@+id/ll_control_layout_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_widget_seekbars"
        app:layout_constraintVertical_bias="0.75">


        <ImageView
            android:id="@+id/music_widget_pre"
            android:layout_width="@dimen/music_widget_size"
            android:layout_height="@dimen/music_widget_size"
            android:layout_gravity="center"
            android:src="@drawable/sf_music_pre" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_play"
            android:layout_width="@dimen/music_widget_size"
            android:layout_height="@dimen/music_widget_size"
            android:src="@drawable/sf_music_bofang"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/music_widget_next"
            android:layout_width="@dimen/music_widget_size"
            android:layout_height="@dimen/music_widget_size"
            android:layout_gravity="center"
            android:src="@drawable/sf_music_next" />
    </LinearLayout>


</com.launcher.ui28.MusicWidget>