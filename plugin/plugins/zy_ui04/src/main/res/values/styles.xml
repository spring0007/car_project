<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="widget_title_tv_style">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_regular</item>

    </style>

    <style name="sub_title_tv_style">
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">@dimen/sub_title_tv_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_regular</item>
        <item name="android:layout_marginTop">@dimen/iv_tv_margin_top</item>
        <item name="android:onClick">onClick</item>
        <item name="android:clickable">true</item>

    </style>

    <style name="small_title_tv_style">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/small_title_text_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_regular</item>
        <item name="android:onClick">onClick</item>
        <item name="android:clickable">true</item>

    </style>

</resources>