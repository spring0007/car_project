            <!-- 专辑图背景 -->
            <ImageView
                android:id="@+id/img_song_art_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="41dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/ui7_music_icon" />
            <!-- 歌手名 -->

            <!-- 歌曲名 -->

            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="31dp"
                android:layout_marginTop="35dp"
                android:layout_toEndOf="@+id/img_song_art_bg"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/music_artist"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/music_artist"
                android:layout_alignParentTop="true"
                android:layout_marginStart="38dp"
                android:layout_marginTop="80dp"
                android:layout_toEndOf="@+id/img_song_art_bg"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="20sp" />


