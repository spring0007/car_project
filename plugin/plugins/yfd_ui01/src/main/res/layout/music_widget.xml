        <!-- 进度条 -->
        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="449dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:progressDrawable="@drawable/custom_progress_drawable"
            android:thumb="@drawable/circle_shape"
            android:thumbOffset="0dip"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/ll_name_layout_music"

            tools:ignore="MissingConstraints" />

        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal"
            android:layout_below="@+id/music_widget_seekbars"
            >


            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="10dp"
                android:src="@drawable/sf_music_pre"
                tools:ignore="ContentDescription" />


            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="110dp"
                android:layout_marginRight="110dp"
                android:padding="10dp"
                android:src="@drawable/sf_music_bofang"
                tools:ignore="ContentDescription" />


            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="10dp"
                android:src="@drawable/sf_music_next"
                tools:ignore="ContentDescription" />


        </LinearLayout>
