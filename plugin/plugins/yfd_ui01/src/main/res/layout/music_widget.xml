<com.launcher.yfd_ui01.view.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/rectangle_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_name_layout_music"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintVertical_bias="0.17"
            app:layout_constraintHeight_percent="0.32"
            >

            <!-- 专辑图背景 -->
            <ImageView
                android:id="@+id/img_song_art_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="1.0"
                app:layout_constraintDimensionRatio="W,16:10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/ui7_music_icon"
                android:importantForAccessibility="no"
                 />

            <!-- 歌曲名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/img_song_art_bg"
                app:layout_constraintBottom_toTopOf="@+id/music_artist"
                app:layout_constraintWidth_percent="0.65"
                app:layout_constraintHorizontal_bias="0.90"
                app:layout_constraintVertical_bias="0.40"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                tools:ignore="MissingConstraints"
                />

            <!-- 歌手名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.65"
                app:layout_constraintHorizontal_bias="0.90"
                app:layout_constraintStart_toEndOf="@+id/img_song_art_bg"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/music_artist"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                tools:ignore="MissingConstraints"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 进度条 -->
        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:progressDrawable="@drawable/custom_progress_drawable"
            android:thumb="@drawable/circle_shape"
            android:thumbOffset="0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintVertical_bias="0.55"
            app:layout_constraintTop_toBottomOf="@+id/ll_name_layout_music"
            tools:ignore="MissingConstraints" />

        <!-- 音乐控制 -->
        <RelativeLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.70"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintTop_toBottomOf="@+id/music_widget_seekbars">


            <ImageView
                android:id="@+id/music_widget_pre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="10dp"
                android:src="@drawable/sf_music_pre"
                tools:ignore="ContentDescription" />


            <ImageView
                android:id="@+id/music_widget_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"
                android:padding="10dp"
                android:src="@drawable/sf_music_bofang"
                tools:ignore="ContentDescription" />


            <ImageView
                android:id="@+id/music_widget_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="10dp"
                android:src="@drawable/sf_music_next"
                tools:ignore="ContentDescription" />


        </RelativeLayout>
</com.launcher.yfd_ui01.view.MusicWidget>