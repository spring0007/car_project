<?xml version="1.0" encoding="utf-8"?>
<com.launcher.yfd_ui01.view.DialWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dial_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.launcher.yfd_ui01.view.AnalogClockView
        android:id="@+id/analogClockView"
        android:layout_width="219dp"
        android:layout_height="219dp"
        tools:ignore="MissingConstraints" />

    <TextClock
        android:id="@+id/dial_am_pm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="19dp"
        android:format12Hour="aa"
        android:format24Hour="aa"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextClock
        android:id="@+id/dial_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:format12Hour="dd-MM EE"
        android:format24Hour="dd-MM EE"
        android:textColor="@color/white"
        android:textSize="21sp" />


</com.launcher.yfd_ui01.view.DialWidget>