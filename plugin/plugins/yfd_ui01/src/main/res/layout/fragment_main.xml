    <!-- bottom app -->
    <GridLayout
        android:id="@+id/host_linear"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.23"
        app:layout_constraintHeight_percent="0.43"
        android:columnCount="2"
        android:orientation="horizontal"
        android:rowCount="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.96"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.93">


        <com.launcher.yfd_ui01.view.AppItemView
            android:id="@+id/hotset_bt_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:appBg="@drawable/yfd_ui1_bg"
            app:appIcon="@drawable/yfd_ui1_bluetooth"
            app:appName="@string/bluetooth"
            />

        <com.launcher.yfd_ui01.view.AppItemView
            android:id="@+id/hotset_all_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:appBg="@drawable/yfd_ui1_bg"
            app:appIcon="@drawable/yfd_ui1_menu"
            app:appName="@string/apps"
            />

        <com.launcher.yfd_ui01.view.AppItemView
            android:id="@+id/hotset_dsp_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:appBg="@drawable/yfd_ui1_bg"
            app:appIcon="@drawable/yfd_ui1_dsp"
            app:appName="@string/dsp"
            />

        <com.launcher.yfd_ui01.view.AppItemView
            android:id="@+id/hotset_window_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:appBg="@drawable/yfd_ui1_bg"
            app:appIcon="@drawable/yfd_ui1_windowapp"
            app:appName="@string/window_app"
            />

    </GridLayout>


</androidx.constraintlayout.widget.ConstraintLayout>