    <!-- music layout -->
    <include layout="@layout/music_widget"
        android:id="@+id/layout_music_widget"
        android:layout_width="531dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        android:layout_marginBottom="23dp"
        />

    <!-- car speed -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="142dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/car_speed_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120"
            android:fontFamily="@font/harmonyos_sans_sc_medium"
            android:textColor="@color/grey_9494"
            android:textSize="75sp"
             />

        <TextView
            android:id="@+id/car_speed_unit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km/h"
            android:textColor="@color/grey_9494"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:layout_marginStart="18dp"
            android:textSize="30sp"
             />
    </LinearLayout>

    <!-- bottom app -->
    <GridLayout
        android:id="@+id/host_linear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:columnCount="2"
        android:orientation="horizontal"
        android:rowCount="2"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="41dp"
        >

        <Button
            android:id="@+id/hotset_bt_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bluetooth"
            android:layout_marginBottom="@dimen/app_margin_end"
            style="@style/app_btn_text"
            android:drawableTop="@drawable/ui7_bt_icon_d"/>


        <Button
            android:id="@+id/hotset_all_app"
            style="@style/app_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_margin_start"
            android:layout_marginBottom="@dimen/app_margin_end"
            android:drawableTop="@drawable/ui7_menu_icon_d"
            android:text="@string/apps" />

        <Button
            android:id="@+id/hotset_dsp_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dsp"
            style="@style/app_btn_text"
            android:drawableTop="@drawable/ui7_dsp_icon_d" />

        <Button
            android:id="@+id/hotset_window_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_margin_start"
            android:text="@string/window_app"
            style="@style/app_btn_text"
            android:drawableTop="@drawable/ui7_window_icon_d" />

    </GridLayout>


</androidx.constraintlayout.widget.ConstraintLayout>