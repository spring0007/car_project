<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    android:layout_width="@dimen/recycle_app_item_width"
    android:layout_height="@dimen/recycle_app_item_height"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">


    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="@dimen/recycle_app_icon_size"
        android:layout_height="@dimen/recycle_app_icon_size"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_horizontal"
        android:fontFamily="@font/harmonyos_sans_sc_regular"
        android:layout_centerHorizontal="true"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="app_name"
        android:textColor="@android:color/white"
        android:textSize="@dimen/shortcut_tv_size" />

    <View
        android:id="@+id/line"
        android:layout_width="2dp"
        android:layout_height="@dimen/recycle_app_item_width"
        android:background="@color/gray"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        />
</RelativeLayout>