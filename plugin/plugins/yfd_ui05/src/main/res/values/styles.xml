<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="widget_title_tv_style">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_regular</item>

    </style>

    <style name="widget_sub_title_tv_style">
        <item name="android:textColor">#ced0d5</item>
        <item name="android:textSize">@dimen/sub_title_tv_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/harmonyos_sans_sc_regular</item>

    </style>

    <style name="iv_bt_con_style">
        <item name="android:layout_width">@dimen/music_widget_iv_size</item>
        <item name="android:layout_height">@dimen/music_widget_iv_size</item>
        <item name="android:clickable">true</item>
        <item name="android:onClick">onClick</item>
    </style>
</resources>