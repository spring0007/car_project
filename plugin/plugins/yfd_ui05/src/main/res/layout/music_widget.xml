<com.launcher.yfd_ui5.MusicWidget xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_vertical"
    >
        <ImageView
            android:id="@+id/music_widget_title_icon"
            android:layout_width="@dimen/widget_title_icon_width"
            android:layout_height="@dimen/widget_title_icon_width"
            android:scaleType="fitXY"
            android:src="@drawable/music_title_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread" />

        <TextView
            android:id="@+id/music_tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/music"
            style="@style/widget_title_tv_style"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_widget_title_icon"
            app:layout_constraintBottom_toTopOf="@+id/music_widget_music_name"
            app:layout_constraintWidth_percent="0.8" />


        <LinearLayout
            android:id="@+id/ll_name_layout_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_tv_title"
            app:layout_constraintWidth_percent="0.8">
            <!--歌曲名-->
            <!--<TextView
                android:id="@+id/music_widget_music_name"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/harmonyos_sans_sc_bold"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:paddingLeft="15dp"
                android:paddingEnd="15dp"
                android:text="@string/click_play_music"
                android:textColor="@android:color/white"
                android:textSize="32sp" />-->
            <!-- 歌手名 -->
            <com.awell.launcher2.EarqueeTextView
                android:id="@+id/music_artist"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:fontFamily="@font/harmonyos_sans_sc_light"
                android:gravity="start|center_vertical"
                android:marqueeRepeatLimit="marquee_forever"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:visibility="gone" />
            <!-- 进度条  style="@style/volume_SeekBar"  -->
            <RelativeLayout
                android:id="@+id/ll_time_layout_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone">
                <!-- 当前时间 -->
                <TextView
                    android:id="@+id/music_widget_cur_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignStart="@+id/music_widget_seekbars2"
                    android:layout_marginStart="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 总时间 -->
                <TextView
                    android:id="@+id/music_widget_total_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/music_widget_seekbars2"
                    android:layout_alignEnd="@+id/music_widget_seekbars2"
                    android:layout_marginEnd="15dp"
                    android:text="00:00"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
                <!-- 进度条    style="@style/volume_SeekBar"  -->
                <SeekBar
                    android:id="@+id/music_widget_seekbars2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="20dp"
                    android:thumb="@null"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rl_music_ablum_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2">

            <RelativeLayout
                android:id="@+id/rl_music_ablum_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <!-- 专辑图背景 -->
                <ImageView
                    android:id="@+id/img_song_art_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter" />
                <!-- 专辑图片 -->
                <ImageView
                    android:id="@+id/img_song_art"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_centerInParent="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription" />

            </RelativeLayout>
        </LinearLayout>


        <com.awell.launcher2.EarqueeTextView
            android:id="@+id/music_widget_music_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:text="@string/unknown_song"
            style="@style/widget_sub_title_tv_style"
            app:layout_constraintWidth_percent="0.8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_tv_title"
            app:layout_constraintBottom_toTopOf="@+id/ll_control_layout_music"
            tools:ignore="MissingConstraints" />

        <!-- 音乐控制 -->
        <LinearLayout
            android:id="@+id/ll_control_layout_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/music_widget_pre"
                style="@style/iv_bt_con_style"
                android:src="@drawable/sf_music_pre"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="@dimen/iv_gav_width"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/music_widget_play"
                style="@style/iv_bt_con_style"
                android:src="@drawable/sf_music_bofang"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="@dimen/iv_gav_width"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/music_widget_next"
                style="@style/iv_bt_con_style"
                android:src="@drawable/sf_music_next"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/music_widget_seekbars"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:progressDrawable="@drawable/custom_progress_drawable"
            android:thumb="@null"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_music_ablum_container" />
</com.launcher.yfd_ui5.MusicWidget>