<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityUI4"
    android:background="@color/black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UI 4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/music_widget_bg_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_music_widget"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2" />

    <include
        android:id="@+id/layout_music_widget"
        layout="@layout/music_widget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_widget_bg_iv"
        app:layout_constraintEnd_toEndOf="@+id/music_widget_bg_iv"
        app:layout_constraintStart_toStartOf="@+id/music_widget_bg_iv"
        app:layout_constraintTop_toTopOf="@+id/music_widget_bg_iv"
        app:layout_constraintHorizontal_bias="0.3"/>

    <ImageView
        android:id="@+id/car_iv"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/sf_car_bg"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintStart_toEndOf="@+id/music_widget_bg_iv"
        app:layout_constraintTop_toTopOf="@+id/music_widget_bg_iv"
        app:layout_constraintBottom_toBottomOf="@+id/music_widget_bg_iv" />

    <TextView
        android:id="@+id/car_speed_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120"
        android:textColor="@color/white"
        android:textSize="90sp"
        app:layout_constraintBottom_toBottomOf="@+id/car_iv"
        app:layout_constraintEnd_toEndOf="@+id/car_iv"
        app:layout_constraintStart_toStartOf="@+id/car_iv"
        app:layout_constraintTop_toTopOf="@+id/car_iv"
        app:layout_constraintHorizontal_bias="0.03"
        app:layout_constraintVertical_bias="0.9"/>

    <TextView
        android:id="@+id/car_speed_unit_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="km/h"
        android:textColor="@color/white"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="@+id/car_speed_tv"
        app:layout_constraintStart_toEndOf="@+id/car_speed_tv"
        app:layout_constraintTop_toTopOf="@id/car_speed_tv"
        app:layout_constraintVertical_bias="0.8"/>

    <ImageView
        android:id="@+id/rv_bg_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sf_rv_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.95" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.95" />

    <ImageView
        android:id="@+id/hotset_allapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:src="@drawable/hotset_all_app"
        app:layout_constraintBottom_toBottomOf="@+id/rv_bg_iv"
        app:layout_constraintEnd_toEndOf="@+id/rv_bg_iv"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="@+id/rv_bg_iv"
        app:layout_constraintTop_toTopOf="@+id/rv_bg_iv"
        android:visibility="gone"/>

    <include
        android:id="@+id/layout_radio_widget"
        layout="@layout/radio_widget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/rv_bg_iv"
        app:layout_constraintBottom_toBottomOf="@+id/rv_bg_iv"
        app:layout_constraintStart_toEndOf="@+id/rv_bg_iv"
        app:layout_constraintEnd_toEndOf="@+id/car_iv"
        app:layout_constraintVertical_bias="0.95"
        android:layout_marginStart="30dp" />

</androidx.constraintlayout.widget.ConstraintLayout>