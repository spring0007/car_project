<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityUI10">

    <!-- 时间卡片背景:宽度 = 屏宽 43.3%,高度按 554:212 推导 -->
    <ImageView
        android:id="@+id/time_bg_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/sf_time_bg"
        app:layout_constraintDimensionRatio="554:212"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.3"
        app:layout_constraintWidth_percent="0.433" />

    <!-- 左侧时钟底板:宽度 = 屏宽 15.3%,高度按 196:144 推导 -->
    <ImageView
        android:id="@+id/time_bg_left_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/time_bg"
        app:layout_constraintBottom_toBottomOf="@+id/time_bg_iv"
        app:layout_constraintDimensionRatio="196:144"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/time_bg_iv"
        app:layout_constraintVertical_bias="0.385"
        app:layout_constraintWidth_percent="0.153" />

    <!-- 右侧时钟底板,宽度同上 -->
    <ImageView
        android:id="@+id/time_bg_right_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/time_bg"
        app:layout_constraintBottom_toBottomOf="@+id/time_bg_iv"
        app:layout_constraintDimensionRatio="196:144"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toEndOf="@+id/time_bg_left_iv"
        app:layout_constraintTop_toTopOf="@+id/time_bg_iv"
        app:layout_constraintVertical_bias="0.385"
        app:layout_constraintWidth_percent="0.153" />

    <TextClock
        android:id="@+id/time_hour"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:format12Hour="h"
        android:format24Hour="HH"
        android:gravity="center"
        android:text="00:00"
        android:textColor="@android:color/black"
        android:textSize="@dimen/time_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/time_bg_left_iv"
        app:layout_constraintEnd_toEndOf="@+id/time_bg_left_iv"
        app:layout_constraintStart_toStartOf="@+id/time_bg_left_iv"
        app:layout_constraintTop_toTopOf="@+id/time_bg_left_iv" />

    <TextClock
        android:id="@+id/time_minute"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:format12Hour="mm"
        android:format24Hour="mm"
        android:gravity="center"
        android:textSize="@dimen/time_text_size"
        android:text="00:00"
        android:textColor="@android:color/black"
        app:layout_constraintBottom_toBottomOf="@+id/time_bg_right_iv"
        app:layout_constraintEnd_toEndOf="@+id/time_bg_right_iv"
        app:layout_constraintStart_toStartOf="@+id/time_bg_right_iv"
        app:layout_constraintTop_toTopOf="@+id/time_bg_right_iv" />

    <TextClock
        android:id="@+id/date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:format12Hour="yyyy/MM/dd"
        android:format24Hour="yyyy/MM/dd"
        android:text="2020年5月18日"
        android:textColor="@android:color/white"
        android:textSize="@dimen/host_tv_size"
        android:singleLine="true"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="@+id/time_bg_left_iv"
        app:layout_constraintEnd_toEndOf="@+id/time_bg_left_iv"
        app:layout_constraintTop_toBottomOf="@+id/time_bg_left_iv"/>

    <TextClock
        android:id="@+id/weekday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:text="星期五"
        android:singleLine="true"
        android:gravity="center_horizontal"
        android:textColor="@android:color/white"
        android:textSize="@dimen/host_tv_size"
        app:layout_constraintStart_toStartOf="@+id/time_bg_right_iv"
        app:layout_constraintEnd_toEndOf="@+id/time_bg_right_iv"
        app:layout_constraintTop_toBottomOf="@+id/time_bg_right_iv" />

    <!-- music layout:与时间卡片等宽等高,位于时间卡片右侧 -->
    <include
        layout="@layout/music_widget"
        android:id="@+id/layout_music_widget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/music_layout_start"
        app:layout_constraintDimensionRatio="554:212"
        app:layout_constraintStart_toEndOf="@+id/time_bg_iv"
        app:layout_constraintTop_toTopOf="@+id/time_bg_iv"
        app:layout_constraintBottom_toBottomOf="@+id/time_bg_iv"
        app:layout_constraintWidth_percent="0.43" />


    <ImageView
        android:id="@+id/hotset_nav_app"
        android:layout_width="@dimen/hotset_width"
        android:layout_height="@dimen/hotset_height"
        android:src="@drawable/sf_navi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hotset_radio_app"
        app:layout_constraintTop_toBottomOf="@+id/time_bg_iv"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/hotset_navi_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/navi"
        app:layout_constraintStart_toStartOf="@+id/hotset_nav_app"
        app:layout_constraintEnd_toEndOf="@+id/hotset_nav_app"
        app:layout_constraintTop_toBottomOf="@+id/hotset_nav_app"
        android:textSize="@dimen/host_tv_size"/>

    <ImageView
        android:id="@+id/hotset_radio_app"
        android:layout_width="@dimen/hotset_width"
        android:layout_height="@dimen/hotset_height"
        android:src="@drawable/sf_radio"
        app:layout_constraintStart_toEndOf="@+id/hotset_nav_app"
        app:layout_constraintTop_toTopOf="@+id/hotset_nav_app"
        app:layout_constraintBottom_toBottomOf="@+id/hotset_nav_app"
        app:layout_constraintEnd_toStartOf="@+id/hotset_music_app" />

    <TextView
        android:id="@+id/hotset_radio_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/radio"
        app:layout_constraintStart_toStartOf="@+id/hotset_radio_app"
        app:layout_constraintEnd_toEndOf="@+id/hotset_radio_app"
        app:layout_constraintTop_toBottomOf="@+id/hotset_radio_app"
        android:textSize="@dimen/host_tv_size"/>

    <ImageView
        android:id="@+id/hotset_music_app"
        android:layout_width="@dimen/hotset_width"
        android:layout_height="@dimen/hotset_height"
        android:src="@drawable/sf_music"
        app:layout_constraintTop_toTopOf="@+id/hotset_nav_app"
        app:layout_constraintBottom_toBottomOf="@+id/hotset_nav_app"
        app:layout_constraintStart_toEndOf="@+id/hotset_radio_app"
        app:layout_constraintEnd_toStartOf="@+id/hotset_video_app" />

    <TextView
        android:id="@+id/hotset_music_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/music"
        app:layout_constraintStart_toStartOf="@+id/hotset_music_app"
        app:layout_constraintEnd_toEndOf="@+id/hotset_music_app"
        app:layout_constraintTop_toBottomOf="@+id/hotset_music_app"
        android:textSize="@dimen/host_tv_size"/>

    <ImageView
        android:id="@+id/hotset_video_app"
        android:layout_width="@dimen/hotset_width"
        android:layout_height="@dimen/hotset_height"
        android:src="@drawable/sf_video"
        app:layout_constraintTop_toTopOf="@+id/hotset_nav_app"
        app:layout_constraintBottom_toBottomOf="@+id/hotset_nav_app"
        app:layout_constraintStart_toEndOf="@+id/hotset_music_app"
        app:layout_constraintEnd_toStartOf="@+id/hotset_btapp" />

    <TextView
        android:id="@+id/hotset_video_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/video"
        app:layout_constraintStart_toStartOf="@+id/hotset_video_app"
        app:layout_constraintEnd_toEndOf="@+id/hotset_video_app"
        app:layout_constraintTop_toBottomOf="@+id/hotset_video_app"
        android:textSize="@dimen/host_tv_size"/>

    <ImageView
        android:id="@+id/hotset_btapp"
        android:layout_width="@dimen/hotset_width"
        android:layout_height="@dimen/hotset_height"
        android:src="@drawable/sf_bt"
        app:layout_constraintTop_toTopOf="@+id/hotset_nav_app"
        app:layout_constraintBottom_toBottomOf="@+id/hotset_nav_app"
        app:layout_constraintStart_toEndOf="@+id/hotset_video_app"
        app:layout_constraintEnd_toStartOf="@+id/hotset_allapp" />

    <TextView
        android:id="@+id/hotset_bt_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phone"
        app:layout_constraintStart_toStartOf="@+id/hotset_btapp"
        app:layout_constraintEnd_toEndOf="@+id/hotset_btapp"
        app:layout_constraintTop_toBottomOf="@+id/hotset_btapp"
        android:textSize="@dimen/host_tv_size"/>

    <ImageView
        android:id="@+id/hotset_allapp"
        android:layout_width="@dimen/hotset_width"
        android:layout_height="@dimen/hotset_height"
        android:src="@drawable/sf_all"
        app:layout_constraintStart_toEndOf="@+id/hotset_btapp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/hotset_nav_app"
        app:layout_constraintBottom_toBottomOf="@+id/hotset_nav_app" />

      <TextView
        android:id="@+id/hotset_all_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/all_app"
        app:layout_constraintStart_toStartOf="@+id/hotset_allapp"
        app:layout_constraintEnd_toEndOf="@+id/hotset_allapp"
        app:layout_constraintTop_toBottomOf="@+id/hotset_allapp"
        android:textSize="@dimen/host_tv_size"/>

</androidx.constraintlayout.widget.ConstraintLayout>
