<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_car"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_anim_speed_road"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:background="@drawable/rainbow_01"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_main_xiaodeng"
        android:layout_width="186dp"
        android:layout_height="150dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:src="@drawable/off"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_gps_speed"
        android:layout_width="158dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:gravity="end"
        android:paddingTop="12dp"
        android:shadowColor="#66000000"
        android:shadowDx="-5"
        android:shadowDy="-5"
        android:shadowRadius="10"
        android:text="0"
        android:textColor="@android:color/white"
        android:textSize="80sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_gps_speed_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/tv_gps_speed"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/tv_gps_speed"
        android:shadowColor="#88000000"
        android:shadowDx="-3"
        android:shadowDy="-3"
        android:shadowRadius="2"
        android:text="KM/h"
        android:textColor="@android:color/white"
        android:textSize="26sp" />
</RelativeLayout>