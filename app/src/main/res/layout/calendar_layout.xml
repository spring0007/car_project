<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_marginTop="10dp"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/titleRl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:gravity="center">

        <TextClock
            android:id="@+id/weekday"
            android:fontFamily="@font/harmonyos_sans_sc_regular"
            android:layout_weight="4"
            android:paddingStart="35dp"
            android:gravity="start|center"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:format12Hour="E"
            android:format24Hour="E"
            android:textColor="@android:color/white"
            android:textSize="22dp" />

        <ImageView
            android:clickable="true"
            android:id="@+id/lastTv"
            android:layout_weight="1"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:src="@drawable/radio_left_icon_n"
            android:gravity="center" />

        <TextView
            android:layout_gravity="center"
            android:id="@+id/monthTv"
            android:layout_width="0dp"
            android:layout_weight="4.5"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="十一月"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="27sp" />

        <ImageView
            android:id="@+id/nextTv"
            android:gravity="center"
            android:layout_alignParentRight="true"
            android:src="@drawable/radio_right_icon_n"
            android:layout_weight="1"
            android:layout_width="27dp"
            android:layout_height="27dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:id="@+id/weekLl"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8">

        <TextView
            android:id="@+id/Tv1"
            android:text="M"
            android:textSize="@dimen/font_size"
            android:gravity="center"
            android:textColor="@color/myGray_rv"
            android:background="@color/text_color_bg"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/calendar_item_h" />

        <TextView
            android:id="@+id/Tv2"
            android:text="T"
            android:textSize="@dimen/font_size"
            android:textColor="@color/myGray_rv"
            android:gravity="center"
            android:background="@color/text_color_bg"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/calendar_item_h" />

        <TextView
            android:id="@+id/Tv3"
            android:textColor="@color/myGray_rv"
            android:text="W"
            android:textSize="@dimen/font_size"
            android:gravity="center"
            android:background="@color/text_color_bg"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/calendar_item_h" />

        <TextView
            android:id="@+id/Tv4"
            android:textColor="@color/myGray_rv"
            android:text="T"
            android:textSize="@dimen/font_size"
            android:gravity="center"
            android:background="@color/text_color_bg"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/calendar_item_h" />

        <TextView
            android:id="@+id/Tv5"
            android:textColor="@color/myGray_rv"
            android:text="F"
            android:textSize="@dimen/font_size"
            android:gravity="center"
            android:background="@color/text_color_bg"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/calendar_item_h" />


        <TextView
            android:id="@+id/Tv6"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="@dimen/calendar_item_h"
            android:background="@color/text_color_bg"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/myGray_rv"
            android:textSize="@dimen/font_size" />

        <TextView
            android:textColor="@color/myGray_rv"
            android:paddingTop="1dp"
            android:id="@+id/Tv7"
            android:text="S"
            android:layout_weight="1"
            android:textSize="@dimen/font_size"
            android:gravity="center"
            android:background="@color/text_color_bg"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/calendar_item_h" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.5">

        <GridView
            android:focusableInTouchMode="false"
            android:focusable="false"
            android:descendantFocusability="blocksDescendants"
            android:scrollbars="none"
            android:id="@+id/cv_calendar"
            android:numColumns="7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="8dp" />

        <View
            android:id="@+id/cv_calendar_touch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </RelativeLayout>

</LinearLayout>