<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="35dp"
    android:background="@drawable/rv_show_bg"
    tools:ignore="MissingDefaultResource">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_margin="20dp"
            android:id="@+id/time_w_one_img"
            android:background="@drawable/time_w_one"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h">

        </ImageView>
        <ImageView
            android:layout_margin="20dp"
            android:id="@+id/time_w_two_img"
            android:background="@drawable/time_w_two"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h">
        </ImageView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_margin="20dp"
            android:id="@+id/time_w_three_img"
            android:background="@drawable/time_w_three"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h"/>
        <ImageView
            android:layout_margin="20dp"
            android:id="@+id/time_w_four_img"
            android:background="@drawable/time_w_four"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h">
        </ImageView>
    </LinearLayout>
</LinearLayout>