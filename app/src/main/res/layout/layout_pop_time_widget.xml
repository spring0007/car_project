<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rv_show_bg"
    android:orientation="vertical"
    android:padding="35dp"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/time_w_one_img"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h"
            android:layout_margin="20dp"
            android:background="@drawable/time_w_one">

        </ImageView>

        <ImageView
            android:id="@+id/time_w_two_img"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h"
            android:layout_margin="20dp"
            android:background="@drawable/time_w_two"></ImageView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/time_w_three_img"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h"
            android:layout_margin="20dp"
            android:background="@drawable/time_w_three" />

        <ImageView
            android:id="@+id/time_w_four_img"
            android:layout_width="@dimen/time_widget1_item_w"
            android:layout_height="@dimen/time_widget1_item_h"
            android:layout_margin="20dp"
            android:background="@drawable/time_w_four"></ImageView>
    </LinearLayout>
</LinearLayout>