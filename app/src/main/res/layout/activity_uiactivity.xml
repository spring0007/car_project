<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.awell.ui.UIActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/host_bottom_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="horizontal">

                <include
                    layout="@layout/widget_layout_radio_two"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <include
                layout="@layout/car_lamp_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.5" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="0dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/dot_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sel_o" />

                <ImageView
                    android:id="@+id/dot_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/nor_t" />

                <ImageView
                    android:id="@+id/dot_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/nor_t" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/music_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include
                    layout="@layout/widget_layout_music"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="5"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <include
                        layout="@layout/speed_layout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/time_widget_change"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/sf_time_bg_main"
                    android:clickable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:gravity="center"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/time_ll_one"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:background="@drawable/biaopan"
                        android:gravity="center"
                        android:visibility="gone">

                        <com.awell.ctrlview.MyQAnalogClock
                            android:id="@+id/time_biao"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/time_ll_two"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingEnd="10dp"
                        android:visibility="gone">

                        <RelativeLayout
                            android:id="@+id/time_two_rl"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/biaopan_one_iv"
                                android:layout_width="180dp"
                                android:layout_height="180dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="20dp"
                                android:background="@drawable/biaopan_one" />

                            <com.awell.ctrlview.MyQAnalogClock
                                android:id="@+id/time_biao1"
                                android:layout_width="180dp"
                                android:layout_height="180dp"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <TextClock
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:layout_weight="1"
                                    android:format12Hour="E"
                                    android:format24Hour="E"
                                    android:gravity="center"
                                    android:textColor="@android:color/holo_red_light"
                                    android:textSize="32sp"
                                    android:textStyle="bold" />

                                <TextClock
                                    android:id="@+id/page2_date_m"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:layout_weight="1"
                                    android:format12Hour="MMM"
                                    android:format24Hour="MMM"
                                    android:gravity="start"
                                    android:textColor="@android:color/black"
                                    android:textSize="32sp" />
                            </LinearLayout>

                            <TextClock
                                android:id="@+id/page2_date_d"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="10dp"
                                android:layout_weight="2"
                                android:fontFamily="@font/harmonyos_sans_sc_regular"
                                android:format12Hour="dd"
                                android:format24Hour="dd"
                                android:gravity="center_horizontal"
                                android:textColor="@android:color/black"
                                android:textSize="100sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/time_ll_three"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingEnd="10dp"
                        android:visibility="gone">

                        <com.awell.ctrlview.NewCalendar
                            android:id="@+id/calendarView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:clickable="false"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/time_ll_four"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingEnd="10dp"
                        android:visibility="visible">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1.3"
                            android:paddingStart="15dp"
                            android:paddingTop="15dp"
                            android:paddingBottom="15dp">

                            <LinearLayout
                                android:id="@+id/small_calendar_layout"
                                android:layout_width="190dp"
                                android:layout_height="247dp"
                                android:layout_centerInParent="true"
                                android:background="@drawable/four_rili_bg"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextClock
                                    android:id="@+id/small_calendar_month"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_gravity="bottom"
                                    android:layout_weight="0.8"
                                    android:fontFamily="@font/bahnschrift"
                                    android:format12Hour="MMM"
                                    android:format24Hour="MMM"
                                    android:gravity="center|bottom"
                                    android:textColor="@android:color/black"
                                    android:textSize="30sp" />

                                <TextClock
                                    android:id="@+id/small_calendar_day"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginTop="-25dp"
                                    android:layout_weight="2"
                                    android:fontFamily="@font/bahnschrift"
                                    android:format12Hour="dd"
                                    android:format24Hour="dd"
                                    android:gravity="center"
                                    android:textColor="@android:color/black"
                                    android:textSize="100dp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="10dp">

                            <TextClock
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="start"
                                android:layout_weight="1"
                                android:format12Hour="E"
                                android:format24Hour="E"
                                android:gravity="start|bottom"
                                android:textColor="@android:color/holo_red_light"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextClock
                                android:id="@+id/small_calendar_year"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="start"
                                android:layout_weight="1.2"
                                android:format12Hour="yyyy-MM"
                                android:format24Hour="yyyy-MM"
                                android:gravity="start|top"
                                android:textColor="@android:color/black"
                                android:textSize="30sp" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/rv_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/sf_time_bg_main"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_showapp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>


    <FrameLayout
        android:id="@+id/host_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="143dp"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/hotset_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/hotseat_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom">

            <View
                android:id="@+id/start_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/hotset_video"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_video" />

            <ImageView
                android:id="@+id/hotset_navi"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_navi" />

            <ImageView
                android:id="@+id/hotset_allapp"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_all_app" />

            <ImageView
                android:id="@+id/hotset_setting"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_setting" />

            <ImageView
                android:id="@+id/hotset_bluetooth"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_bt" />

            <ImageView
                android:id="@+id/hotset_moshi"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:src="@drawable/hotset_moshi"
                android:visibility="gone" />

            <View
                android:id="@+id/end_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />


            <ImageView
                android:id="@+id/hotset_dianhua"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/hotset_dianhua"
                android:visibility="gone" />

            <include
                layout="@layout/speed_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>


    <Button
        android:id="@+id/start_plugin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="start plugin"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>